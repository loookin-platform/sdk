{
  "name": "@loookin/sdk",
  "version": "0.3.1",
  "description": "Send product usage events to a Loookin workspace and show its in-app surveys.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loookin-platform/sdk.git"
  },
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./surveys": {
      "types": "./dist/surveys.d.ts",
      "import": "./dist/surveys.js",
      "default": "./dist/surveys.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/browser.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tabclose": "npm run build && node tests/manual/tab-close/engines.mjs",
    "test:tabclose:safari": "npm run build && node tests/manual/tab-close/safari.mjs",
    "build": "tsup",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "playwright": "^1.56.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
